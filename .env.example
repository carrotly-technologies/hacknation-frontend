# Base URL of the backend API. Leave empty to use the Vite dev proxy (/api -> http://localhost:3000).
VITE_API_URL=
# Demo accounts on the sign-in page (one-click sign-in, functional POC). Set to false to hide them,
# e.g. in a deployment without the backend demo seed. Read at build time.
VITE_DEMO_ACCOUNTS=
# Docker image only, read at container start (not by Vite): the API address the Content-Security-Policy
# allows in connect-src. Defaults to the VITE_API_URL build arg; empty = same origin only.
# CSP_CONNECT_SRC=
